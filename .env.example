# Copy this file to .env before starting Docker Compose.
DJANGO_SECRET_KEY=generate-a-new-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Initial administrator created by `python manage.py ensure_admin`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=generate-a-strong-admin-password

POSTGRES_DB=cyberapp_db
POSTGRES_USER=cyberscan
POSTGRES_PASSWORD=cyberscan_dev_password

BACKEND_PORT=8000
FRONTEND_PORT=4200
PORTAINER_HTTPS_PORT=9443
CYBERSCAN_SITE_URL=http://localhost:4200
CYBERSCAN_API_URL=http://localhost:8000
CYBERSCAN_HISTORY_URL=http://localhost:4200/historique
REPORT_EMAIL_LINK_MAX_AGE=604800

CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1740

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CyberScan <noreply@localhost>
EMAIL_TIMEOUT=20

# `stat -c '%g' /var/run/docker.sock` on the Linux server.
DOCKER_GID=999
SCANNER_COMMAND_TIMEOUT=60

NVD_API_KEY=
IP_METADATA_LOOKUP_ENABLED=True
IP_METADATA_URL=https://ipwho.is/{ip}
IP_METADATA_TIMEOUT=8
