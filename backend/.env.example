DJANGO_SECRET_KEY=generate-a-new-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# CORS : laisser False en prod ; allowlist explicite des origines frontend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# JWT (minutes / jours)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
POSTGRES_DB=cyberapp_db
POSTGRES_USER=cyberscan
POSTGRES_PASSWORD=generate-a-new-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=generate-a-new-app-password
DEFAULT_FROM_EMAIL=CyberScan <your-account@example.com>
CYBERSCAN_SITE_URL=http://localhost:4200
# Optionnel : surcharge de la destination du QR code présent dans les rapports PDF
# CYBERSCAN_HISTORY_URL=https://cyberscan.example.com/historique
SSH_HOST=your-scanner-host
SSH_PORT=22
SSH_USER=your-scanner-user
SSH_PASSWORD=generate-a-new-ssh-password
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Windows : utiliser le pool solo et un seul scan par worker.
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1740

SSH_AUTO_ADD_HOST_KEY=False
REALTIME_POLL_SECONDS=1.0
REALTIME_STREAM_MAX_SECONDS=300
